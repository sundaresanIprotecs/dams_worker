# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# Secrets never go in the repository.
#
# Not because these particular values matter, but because a secret committed
# once stays in the history after somebody deletes it — and the deletion is
# what makes everyone think it is gone. Every one of these is read from the
# environment instead.
appsettings.Development.json
appsettings.*.local.json
*.pfx
*.p12
.env
.env.*

# Logs.
#
# They are written beside the binary, so they land in the working tree and
# look like source. Nothing in them belongs in a repository: they are
# per-run, per-machine, and they grow — and one day one of them carries a
# token somebody logged by accident.
logs/
*.log

# Packaging leaves gigabytes behind
work/
*.intunewin
